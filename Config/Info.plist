<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only the custom keys live here. Xcode merges its generated entries
	     (bundle name, version, scene manifest, and so on) on top, because
	     GENERATE_INFOPLIST_FILE stays YES. Values are substituted from
	     Config/Base.xcconfig at build time. -->
	<!-- Shown when the compose screen opens the camera. Required by iOS; the
	     app crashes on camera access without it. -->
	<key>NSCameraUsageDescription</key>
	<string>Candid uses the camera so you can take a photo to share with your friends.</string>
	<key>SUPABASE_API_HOST</key>
	<string>$(SUPABASE_API_HOST)</string>
	<key>SUPABASE_PUBLISHABLE_KEY</key>
	<string>$(SUPABASE_PUBLISHABLE_KEY)</string>
	<!-- Newsreader (OFL, Resources/Fonts) is a variable font; the family's
	     default named instance is Regular/Italic at wght 400 — every use in
	     the design is that weight, so no other instance needs registering. -->
	<key>UIAppFonts</key>
	<array>
		<string>Newsreader.ttf</string>
		<string>Newsreader-Italic.ttf</string>
	</array>
	<!-- Auth callback deep link. Supabase's site_url (supabase/config.toml)
	     points confirmation/reset/magic-link emails here; CandidApp's
	     onOpenURL hands the incoming URL to client.auth.session(from:). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.firstzion.candid.auth-callback</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>candid</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
